NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# SQLite database for zero-config local development
DATABASE_URL="file:./dev.db"

# Redis cache (Sprint 7) - optional fallback to in-memory cache
# REDIS_URL="redis://localhost:6379"

# JWT Secret for Session Auth (Sprint 3)
JWT_SECRET="zeroto1-secret-key-32-bytes-minimum-security-2026"

# Stripe Test Keys (Sprint 14) - optional fallback to simulated test mode
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Sentry Monitoring (Sprint 15) - optional
# SENTRY_DSN=""
